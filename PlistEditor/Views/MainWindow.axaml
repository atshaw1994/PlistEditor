<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlistEditor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:PlistEditor.Views"
        xmlns:services="using:PlistEditor.Services"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="PlistEditor.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/PlistEditor.ico"
        Title="{Binding WindowTitle}">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Keyboard Shortcuts -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+R" Command="{Binding SnapshotCommand}" />
        <KeyBinding Gesture="Cmd+R" Command="{Binding SnapshotCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding CleanSnapshotCommand}" />
        <KeyBinding Gesture="Cmd+Shift+R" Command="{Binding CleanSnapshotCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SavePlistCommand}" />
        <KeyBinding Gesture="Cmd+S" Command="{Binding SavePlistCommand}" />
    </Window.KeyBindings>

    <!-- Resources -->
    <Window.Resources>
        <!-- Tab Header Template -->
        <DataTemplate x:Key="TabHeaderTemplate" x:DataType="vm:PlistSectionViewModel">
            <Grid ColumnDefinitions="*,Auto" 
                  HorizontalAlignment="Stretch" 
                  Background="Transparent"
                  Classes.editing="{Binding IsEditing}">
                <Grid.Styles>
                    <Style Selector="StackPanel.header-actions">
                        <Setter Property="Opacity" Value="0" />
                    </Style>

                    <!-- Show buttons on hover ONLY IF NOT in editing mode -->
                    <Style Selector="TabItem:pointerover Grid:not(.editing) StackPanel.header-actions">
                        <Setter Property="Opacity" Value="1" />
                    </Style>
                </Grid.Styles>

                <!-- Read-Only Title -->
                <TextBlock Grid.Column="0" 
                           Text="{Binding Name}" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left"
                           IsVisible="{Binding !IsEditing}"/>

                <!-- Editable Title Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Stretch"
                         IsVisible="{Binding IsEditing}"
                         FontSize="11"
                         Height="24"
                         Margin="0,0,-24,0"/>

                <!-- Action Buttons -->
                <StackPanel Classes="header-actions"
                            Grid.Column="1" 
                            Margin="8,0,0,0" 
                            Orientation="Horizontal" 
                            Spacing="4" 
                            VerticalAlignment="Center">
                    <StackPanel.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                        </Transitions>
                    </StackPanel.Transitions>

                    <!-- Rename Toggle -->
                    <Button Command="{Binding ToggleEditCommand}" ToolTip.Tip="Rename Dictionary">
                        <ic:SymbolIcon Symbol="Edit" FontSize="10"/>
                    </Button>

                    <!-- Delete Dictionary -->
                    <Button Command="{Binding DeleteCommand}" Foreground="Crimson" ToolTip.Tip="Delete Dictionary">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="10"/>
                    </Button>
                </StackPanel>

                <!-- Save Rename -->
                <Button Grid.Column="1" 
                        IsVisible="{Binding IsEditing}" 
                        Command="{Binding ToggleEditCommand}" 
                        HorizontalAlignment="Right"
                        ToolTip.Tip="Save Edits">
                    <ic:SymbolIcon Symbol="Checkmark" FontSize="10"/>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Main Recursive Content Template -->
        <DataTemplate x:Key="RecursiveTabTemplate" x:DataType="vm:PlistSectionViewModel">
            <DockPanel Margin="2">
                <!-- Action Toolbar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Command="{Binding AddItemCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="DocumentAdd" FontSize="16"/>
                            <Label Content="New Element"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddSubTabCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="RowChild" FontSize="16"/>
                            <Label Content="New Sub-Dict (Tab)"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                               
                <ScrollViewer>
                    <StackPanel>
                        <!-- TreeView for leaf items & array elements -->
                        <TreeView ItemsSource="{Binding Items}" 
                                  IsVisible="{Binding Items.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                                  Background="{DynamicResource CaptionButtonBackground}"
                                  Margin="0,0,0,8">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:PlistItemViewModel" ItemsSource="{Binding Children}">
                                    <views:PlistItemControl HorizontalAlignment="Stretch"/>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Sub-Tabs if current dictionary has nested dictionaries -->
                        <TabControl ItemsSource="{Binding SubTabs}" 
                                    IsVisible="{Binding HasSubTabs}"
                                    ItemTemplate="{StaticResource TabHeaderTemplate}"
                                    ContentTemplate="{StaticResource RecursiveTabTemplate}" 
                                    DockPanel.Dock="Top"
                                    TabStripPlacement="Left">
                                <TabControl.Styles>
                                    <Style Selector="TabItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>

                                    <!-- Reveal buttons when hovering over the TabItem -->
                                    <Style Selector="TabItem:pointerover StackPanel#HeaderActions">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </TabControl.Styles>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Top Toolbar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding PlistFilePath}" Margin="20,0,0,0" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Margin="8,0,0,0" Flyout="{StaticResource MainMenuFlyout}">
                <Button.Styles>
                    <Style Selector="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                </Button.Styles>
                <ic:FluentIcon Icon="MoreVertical" IconSize="Size16" />
            </Button>
        </Grid>

        <!-- Main TabControl for first-level dictionaries -->
        <TabControl ItemsSource="{Binding RootLevel}" 
                    SelectedItem="{Binding SelectedSection}"
                    ItemTemplate="{StaticResource TabHeaderTemplate}"
                    ContentTemplate="{StaticResource RecursiveTabTemplate}" 
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    TabStripPlacement="Left">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MaxHeight" Value="36" />
                </Style>
                <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
                <!-- Target the internal ItemsPresenter to handle vertical scrolling -->
                <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                    <Setter Property="ItemsPanel">
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </Setter>
                </Style>
            </TabControl.Styles>
            <!-- Wrap the tab list in a ScrollViewer -->
            <TabControl.Template>
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="Auto,*">
                            <!-- Left Tab Strip with Vertical ScrollViewer -->
                            <ScrollViewer Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>

                            <!-- Selected Tab Content -->
                            <ContentPresenter Grid.Column="1"
                                              Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>
    </DockPanel>
</Window>
