<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PlistEditor.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="450"
        x:Class="PlistEditor.Views.SmbiosGenerator"
        x:DataType="vm:SmbiosGeneratorViewModel"
        Title="Smbios Generator" 
        SizeToContent="WidthAndHeight"
        MinWidth="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="/Assets/PlistEditor.ico">
    <StackPanel Margin="20" Spacing="15">
        <!-- Download Header section -->
        <Border Margin="-20,-20,-20,0" 
                Padding="12" 
                IsVisible="{Binding MacSerialPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                Background="{DynamicResource CaptionButtonBackground}">
            <StackPanel Spacing="8">
                <TextBlock Text="MacSerial not found!" 
                           Foreground="Red"
                           FontWeight="Bold"
                           FontSize="11" 
                           IsVisible="{Binding !IsDownloading}"
                           TextWrapping="Wrap"/>
                <Button Content="Download macserial"
                        Command="{Binding DownloadMacSerialCommand}"
                        IsEnabled="{Binding !IsDownloading}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" 
                           Opacity="0.4"
                           FontStyle="Italic"
                           FontSize="11" 
                           IsVisible="{Binding IsDownloading}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Dropdowns -->
        <StackPanel Spacing="10" IsEnabled="{Binding Categories.Count}">
            <StackPanel Spacing="4">
                <TextBlock Text="Base Type (Category):"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select category..."/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Model Version:"/>
                <ComboBox ItemsSource="{Binding ModelsForCategory}"
                          SelectedItem="{Binding SelectedModel}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select model..."/>
            </StackPanel>
        </StackPanel>

        <!-- Generate Action -->
        <Button Content="Generate SMBIOS"
                Command="{Binding GenerateCommand}"
                IsEnabled="{Binding CanGenerate}"
                Classes="accent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>

        <Separator Margin="0,5"/>

        <!-- Display Output -->
        <StackPanel Spacing="6" IsVisible="{Binding GeneratedResult, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Generated Results:" FontWeight="Bold"/>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,5,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:"/>
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeneratedResult.ModelIdentifier}" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial Number:"/>
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeneratedResult.SystemSerialNumber}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Board Serial (MLB):"/>
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeneratedResult.BoardSerialNumber}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="System UUID:"/>
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeneratedResult.SystemUUID}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="ROM:"/>
                <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GeneratedResult.Rom}"/>
            </Grid>

            <Button Content="Apply to Plist" 
                    Click="ApplyButton_Click" 
                    IsEnabled="{Binding MainViewModelRef.HasLoadedPlist}"
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>